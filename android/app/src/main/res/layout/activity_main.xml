<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121214"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_launcher_foreground"
                android:contentDescription="StepAway Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="StepAway"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Real-time OBS Step Sensor"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLiveStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_tier_bg"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="● STANDBY"
                android:textColor="#9E9EA7"
                android:textSize="11sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live Step & Heart Rate Monitor Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCardUserName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Streamer"
                    android:textColor="#D4D4D8"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <!-- Dynamic Pace Activity Badge (WALKING/RUNNING/IDLE) -->
                <TextView
                    android:id="@+id/tvCardPaceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_tier_bg"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="IDLE"
                    android:textColor="#9E9EA7"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Big Step Counter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvLiveSteps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="46sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="6dp"
                    android:text="steps"
                    android:textColor="#FECA57"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvGoalInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Goal: 5,000"
                    android:textColor="#9E9EA7"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Progress Bar & Percentage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/pbStepProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress_track" />

                <TextView
                    android:id="@+id/tvLivePercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="0%"
                    android:textColor="#00E5FF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Prominent Live Heart Rate (HR Rate Value) Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#26262B"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heart Rate"
                    android:textColor="#9E9EA7"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMonitorBpm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="--"
                    android:textColor="#F43F5E"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="BPM"
                    android:textColor="#9E9EA7"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvMonitorZone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_tier_bg"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="Idle"
                    android:textColor="#9E9EA7"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tracking Action Button -->
            <Button
                android:id="@+id/btnToggleTracking"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#10B981"
                android:text="Start Tracking"
                android:textAllCaps="false"
                android:textColor="#121214"
                android:textSize="16sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Profile & Target Goal Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profil &amp; Target Langkah"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="User ID (Key Unik Akun)"
                android:textColor="#9E9EA7"
                android:textSize="12sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etUserId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#26262B"
                android:hint="streamer"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#71717A"
                android:textSize="14sp"
                android:fontFamily="sans-serif-rounded" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nama Tampilan (Display Name)"
                android:textColor="#9E9EA7"
                android:textSize="12sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#26262B"
                android:hint="Streamer"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#71717A"
                android:textSize="14sp"
                android:fontFamily="sans-serif-rounded" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Target Langkah (Goal)"
                android:textColor="#9E9EA7"
                android:textSize="12sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTargetGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#26262B"
                android:hint="5000"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#71717A"
                android:textSize="14sp"
                android:fontFamily="sans-serif-rounded" />

            <!-- Preset Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPreset3k"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:backgroundTint="#26262B"
                    android:text="3k"
                    android:textAllCaps="false"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPreset5k"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#26262B"
                    android:text="5k"
                    android:textAllCaps="false"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPreset10k"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#26262B"
                    android:text="10k"
                    android:textAllCaps="false"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPreset20k"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#26262B"
                    android:text="20k"
                    android:textAllCaps="false"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#8B5CF6"
                android:text="Simpan Pengaturan ke Server"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Room System Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room System (Co-op / Battle)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="ID Room"
                android:textColor="#9E9EA7"
                android:textSize="12sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRoomId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#26262B"
                android:hint="global"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#71717A"
                android:textSize="14sp"
                android:fontFamily="sans-serif-rounded" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Passcode Room (Kosongkan jika publik)"
                android:textColor="#9E9EA7"
                android:textSize="12sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRoomPasscode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#26262B"
                android:hint="Opsional"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#71717A"
                android:textSize="14sp"
                android:fontFamily="sans-serif-rounded" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnJoinRoom"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:backgroundTint="#26262B"
                    android:text="Gabung Room"
                    android:textAllCaps="false"
                    android:textColor="#00E5FF"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCreateRoom"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#8B5CF6"
                    android:text="Buat Room"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Test Simulator Card (Steps + HR Rate Values) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simulasi Langkah &amp; Detak Jantung"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <!-- Step Sim -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Simulasi Langkah (Sync OBS)"
                android:textColor="#9E9EA7"
                android:textSize="12sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSim1"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:backgroundTint="#26262B"
                    android:text="+1"
                    android:textAllCaps="false"
                    android:textColor="#FECA57"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSim10"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#26262B"
                    android:text="+10"
                    android:textAllCaps="false"
                    android:textColor="#FECA57"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSim100"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#26262B"
                    android:text="+100"
                    android:textAllCaps="false"
                    android:textColor="#FECA57"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSim1000"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#F43F5E"
                    android:text="+1000"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- HR Sim -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Simulasi Detak Jantung (BPM)"
                android:textColor="#9E9EA7"
                android:textSize="12sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSimHr75"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="#26262B"
                    android:text="75"
                    android:textAllCaps="false"
                    android:textColor="#06B6D4"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSimHr125"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#26262B"
                    android:text="125"
                    android:textAllCaps="false"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSimHr155"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#26262B"
                    android:text="155"
                    android:textAllCaps="false"
                    android:textColor="#F97316"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSimHr180"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#26262B"
                    android:text="180"
                    android:textAllCaps="false"
                    android:textColor="#F43F5E"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Connection Settings Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pengaturan Koneksi Server"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Server URL"
                android:textColor="#9E9EA7"
                android:textSize="12sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#26262B"
                android:hint="https://stepaway.endrisusanto.my.id"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#71717A"
                android:textSize="13sp"
                android:fontFamily="sans-serif-rounded" />
        </LinearLayout>

        <!-- Smartband BLE Heart Rate (0x180D) Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Smartband Heart Rate (BLE 0x180D)"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBleStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_tier_bg"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="● DISCONNECTED"
                    android:textColor="#9E9EA7"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Standar GATT 0x180D (Pulsoid / HypeRate broadcast)"
                android:textColor="#9E9EA7"
                android:textSize="11sp"
                android:fontFamily="sans-serif-rounded" />

            <!-- Live BPM Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvLiveBpm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#F43F5E"
                    android:textSize="44sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="6dp"
                    android:text="BPM"
                    android:textColor="#9E9EA7"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvBleZoneBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/widget_tier_bg"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="Idle"
                    android:textColor="#9E9EA7"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvConnectedBleDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tidak ada smartband terhubung"
                android:textColor="#71717A"
                android:textSize="12sp"
                android:fontFamily="sans-serif-rounded" />

            <!-- BLE Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnScanBle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:backgroundTint="#00E5FF"
                    android:text="Scan Smartband"
                    android:textAllCaps="false"
                    android:textColor="#121214"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDisconnectBle"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#26262B"
                    android:text="Putus"
                    android:textAllCaps="false"
                    android:textColor="#F43F5E"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-rounded"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- OBS Overlay Links Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salin Link OBS Overlay"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCopySingle"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:backgroundTint="#26262B"
                    android:text="Step Overlay"
                    android:textAllCaps="false"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCopyHeartrate"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#26262B"
                    android:text="HR Overlay"
                    android:textAllCaps="false"
                    android:textColor="#F43F5E"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCopyCombo"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:backgroundTint="#26262B"
                    android:text="Step + HR Combo"
                    android:textAllCaps="false"
                    android:textColor="#FECA57"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCopyRoom"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#26262B"
                    android:text="Room Overlay"
                    android:textAllCaps="false"
                    android:textColor="#A29BFE"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
