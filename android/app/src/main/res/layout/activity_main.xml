<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Playful Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_launcher_foreground"
                android:contentDescription="StepAway Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="StepAway"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OBS Step Counter &amp; Tracker"
                    android:textColor="#00D2D3"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLiveStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_tier_bg"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="● STANDBY"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live Step Monitor Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCardUserName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Streamer"
                    android:textColor="#CBD5E1"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCardTier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_tier_bg"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="STARTER"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Big Counter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvLiveSteps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="44sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="6dp"
                    android:text="steps"
                    android:textColor="#FECA57"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvGoalInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Goal: 5,000"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Progress Bar & Percentage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/pbStepProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress_track" />

                <TextView
                    android:id="@+id/tvLivePercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="0%"
                    android:textColor="#00D2D3"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Playful Toggle Button -->
            <Button
                android:id="@+id/btnToggleTracking"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#10B981"
                android:text="Start Tracking"
                android:textAllCaps="false"
                android:textColor="#0B0F19"
                android:textSize="16sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Goal & Target Setting Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 Pengaturan Target Langkah"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etTargetGoal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#1E293B"
                    android:hint="5000"
                    android:inputType="number"
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-rounded" />

                <Button
                    android:id="@+id/btnSaveTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="#6C5CE7"
                    android:text="Simpan"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Preset Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPreset3k"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1E293B"
                    android:text="3,000"
                    android:textAllCaps="false"
                    android:textColor="#00D2D3"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPreset5k"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#1E293B"
                    android:text="5,000"
                    android:textAllCaps="false"
                    android:textColor="#00D2D3"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPreset10k"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#1E293B"
                    android:text="10,000"
                    android:textAllCaps="false"
                    android:textColor="#00D2D3"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPreset20k"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#1E293B"
                    android:text="20,000"
                    android:textAllCaps="false"
                    android:textColor="#00D2D3"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Test Simulator Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Simulasi Langkah ke OBS"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSim1"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1E293B"
                    android:text="+1"
                    android:textAllCaps="false"
                    android:textColor="#FECA57"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSim10"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#1E293B"
                    android:text="+10"
                    android:textAllCaps="false"
                    android:textColor="#FECA57"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSim100"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#1E293B"
                    android:text="+100"
                    android:textAllCaps="false"
                    android:textColor="#FECA57"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSim1000"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#FF6B6B"
                    android:text="+1k 🔥"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnResetSteps"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#33FF5252"
                android:text="Reset Langkah Hari Ini"
                android:textAllCaps="false"
                android:textColor="#FF6B6B"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Connection Settings Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ Pengaturan Koneksi Server"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Server URL"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#1E293B"
                android:hint="https://stepaway.endrisusanto.my.id"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13sp"
                android:fontFamily="sans-serif-rounded" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="User ID / Streamer Name"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etUserId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#1E293B"
                android:hint="streamer"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13sp"
                android:fontFamily="sans-serif-rounded" />
        </LinearLayout>

        <!-- OBS Overlay Links Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 Salin Link OBS Overlay"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCopySingle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1E293B"
                    android:text="Single OBS Link"
                    android:textAllCaps="false"
                    android:textColor="#00D2D3"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCopyMulti"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#1E293B"
                    android:text="Multi OBS Link"
                    android:textAllCaps="false"
                    android:textColor="#00D2D3"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
